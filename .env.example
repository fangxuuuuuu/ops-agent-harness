# Copy to .env and adjust. All variables optional; defaults shown.

# LLM provider: "mock" (offline scripted, default) or "openai" (any OpenAI-compatible endpoint)
AGENT_LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini

# Loop limits
AGENT_MAX_STEPS=10
AGENT_TIME_LIMIT_SECONDS=120

# Tool execution policy
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2

# Storage & observability
OPS_DB_PATH=./ops_harness.db
OPS_DATA_DIR=./data
LOG_LEVEL=INFO

# API server
API_HOST=127.0.0.1
API_PORT=8000
